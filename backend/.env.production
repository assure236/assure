# =====================================================
#  PRODUCTION .env TEMPLATE for Hostinger VPS
#  Keep real values only on VPS, never in git
# =====================================================

# Server
NODE_ENV=production
PORT=5000
API_VERSION=v1

# ──── YOUR DOMAINS (update these!) ────
BACKEND_URL=https://api.assure.fund
WEB_CLIENT_URL=https://assure.fund
ADMIN_CLIENT_URL=https://admin.assure.fund

# MongoDB (use MongoDB Atlas or install on VPS)
MONGO_URI=mongodb://localhost:27017/assure_chitfunds

# JWT (Strong random secrets)
JWT_SECRET=<set-on-vps>
JWT_EXPIRES_IN=24h
JWT_REFRESH_SECRET=<set-on-vps>
JWT_REFRESH_EXPIRES_IN=7d



# Cashfree (PRODUCTION)
CASHFREE_APP_ID=<set-on-vps>
CASHFREE_SECRET_KEY=<set-on-vps>
CASHFREE_ENV=PROD
CASHFREE_API_URL=https://api.cashfree.com/pg

# Cashfree Secure ID (VRS/BAV)
CASHFREE_VRS_CLIENT_ID=<set-on-vps>
CASHFREE_VRS_CLIENT_SECRET=<set-on-vps>
# Optional: set when Secure ID 2FA mode is Public Key
CASHFREE_VRS_PUBLIC_KEY=
CASHFREE_VRS_PUBLIC_KEY_PATH=<set-on-vps>

# DigiLocker (get credentials from https://partners.digitallocker.gov.in)
DIGILOCKER_CLIENT_ID=<set-on-vps>
DIGILOCKER_CLIENT_SECRET=<set-on-vps>
DIGILOCKER_REDIRECT_URI=https://api.assure.fund/api/v1/digilocker/callback

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=<set-on-vps>
SMTP_PASSWORD=<set-on-vps>
EMAIL_FROM=<set-on-vps>

# SMS (MSG91)
MSG91_AUTH_KEY=<set-on-vps>
MSG91_TEMPLATE_ID=<set-on-vps>
MSG91_DLT_TEMPLATE_ID=<set-on-vps>
MSG91_SENDER_ID=<set-on-vps>
MSG91_USE_CUSTOM_TEMPLATE=true
MSG91_EMAIL_DOMAIN=<set-on-vps>

# Fast2SMS
FAST2SMS_API_KEY=<set-on-vps>

# Security
BCRYPT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=50000

# Auction
AUCTION_BID_TIMER_SECONDS=300
AUCTION_IDLE_TIMEOUT_SECONDS=60

# Groq AI (for chatbot)
GROQ_API_KEY=<set-on-vps>
